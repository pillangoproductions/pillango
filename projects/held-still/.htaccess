# Held Still — everything in this folder goes through gate.php, which only
# serves files from ./site/ to visitors who entered the password in the box
# on /projects. See README → "Held Still password".
Options -Indexes
DirectoryIndex disabled

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /projects/held-still/
RewriteOptions AllowNoSlash
# the site's relative links need the trailing slash
RewriteCond %{REQUEST_URI} ^/projects/held-still$
RewriteRule ^ /projects/held-still/ [R=301,L]
RewriteRule ^gate\.php$ - [END]
RewriteRule ^(.*)$ gate.php?f=$1 [QSA,END]
</IfModule>

# Never serve the config, even if PHP were switched off.
<FilesMatch "^config(\.sample)?\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
