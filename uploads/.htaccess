# Uploaded files are static media only — never execute scripts here.
# (No php_flag here: DreamHost runs PHP-FPM, where php_flag in
# .htaccess causes a 500 error. Denying + unmapping is enough.)
<FilesMatch "\.(?i:php|phtml|php\d|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml
Options -Indexes
